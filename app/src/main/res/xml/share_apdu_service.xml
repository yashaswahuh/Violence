<?xml version="1.0" encoding="utf-8"?>
<!--
   Tap to share: this phone answers as an NFC Forum Type 4 Tag (NDEF Tag Application, AID
   D2760000850101) holding one link. requireDeviceUnlock keeps a locked phone from answering.
   The service itself is disabled in the manifest and only enabled while the share screen is up.
   See fork-docs/SHARE_DESIGN.md section 3.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/share_nfc_service_description"
    android:requireDeviceUnlock="true">
    <aid-group
        android:category="other"
        android:description="@string/share_nfc_aid_description">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>
