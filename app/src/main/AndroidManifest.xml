            android:label="@string/receive_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Android Auto support -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
          No android:screenOrientation here, deliberately: the app follows the
          system's own auto-rotate setting on every device, phones included.

          [android:configChanges] is the other half of that: without it, a
          rotation the system now allows is still a full Activity restart,
          which throws away every bit of in-memory Compose state along with
          it — the sheet showing Now Playing, whether the lyrics or queue
          panel was open, mid-scrub position, all of it — before any of this
          screen's own responsive layout logic ever gets a chance to run.
          Declaring these configurations here is what turns a rotation back
          into an ordinary recomposition: the same Activity keeps running,
          the same state survives, and the width- and height-aware branches
          in NowPlayingScreen.kt decide the new layout.

          uiMode is deliberately *not* in the list: a day/night change should
          still recreate the Activity so the theme is rebuilt from resources.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Violence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!--
                  What makes the system call this a music app. "Play music" from
                  the assistant, Android Auto's media list and the OEM pickers
                  that put up "Complete action using" all ask for
                  MAIN/APP_MUSIC by name and list whoever answers — a launcher
                  entry alone is not enough, which is why Violence was missing
                  from that dialog while every other player on the device was in
                  it.
                -->
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              The pre-Lollipop spelling of the same request. Deprecated, and
              still what some OEM shortcuts and headset "open music" buttons
              fire, so it costs one filter to be reachable from them too.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              "Play <something>" said out loud, and the search a media app is
              handed when the assistant has words but no app in mind. An empty
              query means "play music" with nothing said about what, which is
              resumed rather than searched — see [MusicLink].
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              YouTube Music links: a song, an album, a playlist or an artist,
              tapped anywhere on the device.

              Not autoVerify. Verification is a claim to *own* these domains,
              which Violence doesn't — and on Android 12+ an app that has
              verified them (the YouTube Music app itself) takes the link
              without a dialog either way. Declaring the filter is what puts
              Violence in the "Open with" list once the user turns YT Music's
              "Open supported links" off; the SEND filter below is the path
              that always works, because sharing asks rather than routing.

              One host, not a family of them. Every entry here becomes a line
              the user has to tick under "Supported web addresses", so a
              plausible-looking host that never appears in a real link (a `www.`
              form of this one, say) is a line to tick by mistake instead of the
              one that matters.

              Schemes and paths still multiply out: every scheme × every path
              prefix listed here is one accepted shape.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/browse" />
                <data android:pathPrefix="/channel" />
                <data android:pathPrefix="/search" />
            </intent-filter>
            <!--
              youtu.be short links, which are a bare video id and nothing else.
              Kept in their own filter because the path there *is* the id, so it
              can't share the path prefixes above.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!-- Listen Together invites as web links: https://yashaswahuh.is-a.dev/Violence/party/<CODE>.
                 autoVerify makes a tap open Violence directly once the domain publishes its
                 assetlinks.json for the release signing certificate (fork-docs/APP_LINKS.md);
                 until then, or when it does not verify, the link opens the web landing page, which
                 has an "Open in Violence app" button. Prefixes, not patterns, so more can be added:
                 later features (a shared song, a profile) are one more <data> line each, e.g.
                 /Violence/song/ and /Violence/profile/ (the web page for them has to exist first). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="yashaswahuh.is-a.dev" />
                <data android:pathPrefix="/Violence/party/" />
                <data android:pathPrefix="/Violence/invite/" />
                <!-- Phase 9: a shared song and a shared profile card (fork-docs/SHARE_DESIGN.md). -->
                <data android:pathPrefix="/Violence/song/" />
                <data android:pathPrefix="/Violence/playlist/" />
                <data android:pathPrefix="/Violence/profile" />
            </intent-filter>

            <!-- Custom scheme for Listen Together invites on custom server deployments. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="violence" />
                <data android:host="party" />
                <data android:host="song" />
                <data android:host="profile" />
            </intent-filter>

            <!--
              A violence:// link read from an NFC tag (another phone doing Tap to share). Android
              tries NDEF_DISCOVERED before any other tag intent, so this opens the app even when it
              is closed. Not BROWSABLE: nothing on the web can fire it. Android 17 (API 37) will
              want android.permission.DISPATCH_NFC_MESSAGE on an activity that receives NFC
              intents for apps that target above API 36; this app targets 36, so it is not added
              yet (fork-docs/SHARE_DESIGN.md section 4.1).
            -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="violence" />
                <data android:host="party" />
                <data android:host="song" />
                <data android:host="profile" />
            </intent-filter>

            <!--
              Share → Violence, from YT Music's own share sheet or from
              anywhere a link can be sent. The text is whatever the sending app
              wrote around the URL, so the URL is picked out of it rather than
              parsed whole.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              "Open with" for an audio file: a file manager, a downloads list, a
              tapped attachment. Typed rather than matched on extension, which
              is what every sender actually fills in — and the two Ogg/FLAC
              spellings are there because some file managers still type those
              files as applications. Answered by MusicLink.LocalFile.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/x-flac" />
            </intent-filter>
        </activity>

