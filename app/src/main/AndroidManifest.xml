        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Violence"
        tools:targetApi="34">

        <!--
          Lets a release build be sampled with simpleperf or Perfetto from adb,
          so jank is measured on the build users get rather than on a debug
          build that is slow for its own reasons. No runtime cost.
        -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
          One UI 7+ only routes an app's ongoing notification to Live
          Notifications / the Now Bar if the app opts in here. Ignored by every
          other OEM. Samsung additionally gates the non-media Live Notification
          extras behind a per-package allowlist; the media card does not need it.
        -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <!-- Quick Settings tile: opens Violence on the Receive page. -->
        <service
            android:name=".share.ReceiveTileService"
            android:exported="true"
