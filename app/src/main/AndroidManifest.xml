        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Commands from the Violence watch app (wearos/). Exported because Play
          services binds it; only messages from the same package and signing key
          on a paired watch are ever delivered, and only under this path.
        -->
        <service
            android:name=".wear.WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/violence/command"
                    android:scheme="wear" />
            </intent-filter>
            <!-- The watch's player reading a track through the phone. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/violence/stream"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          Downloads. Not exported: it is started by the app and by its own
          cancel action, and nothing outside has any business queueing work.
        -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The tap on a "new songs in this playlist" notification. See PlaylistSync. -->
        <receiver
            android:name=".download.PlaylistSyncApproval"
            android:exported="false" />

        <!--
          WorkManager comes up on first use instead of at every launch, since the
          one thing using it is a setting that is off by default.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Home-screen widgets. Two providers so the picker lists a 2×2 and a 4×2,
          both of which are the same widget resized — see MediaWidget.

          Not exported, which is correct for a widget provider despite the
          launcher being the one that talks to it: the system delivers
          APPWIDGET_UPDATE to providers regardless, and the button PendingIntents
          are sent with this app's own identity. Exporting them would only make
          the update broadcast reachable by anything on the device.
        -->
        <receiver
            android:name=".widget.MediaWidgetSquare"
            android:exported="false"
            android:label="@string/widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_square" />
        </receiver>

        <receiver
            android:name=".widget.MediaWidgetWide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_wide" />
        </receiver>

        <!-- The 4×1 capsule. Its own provider and layout; see MediaWidgetPill. -->
        <receiver
            android:name=".widget.MediaWidgetPill"
            android:exported="false"
            android:label="@string/widget_pill_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_pill" />
        </receiver>

        <!-- The transport buttons. Reached only by this app's own PendingIntents. -->
        <receiver
            android:name=".widget.MediaWidgetActions"
            android:exported="false" />

        <!--
          Hands the Replay poster to whichever app the user picks to send it
          with. The authority is derived from the applicationId rather than
          written out, because the dev and prod flavours are two packages that
          can be installed side by side — a fixed authority would make the
          second install fail outright with INSTALL_FAILED_CONFLICTING_PROVIDER.

          Not exported, and grantUriPermissions is the whole mechanism: the
          receiving app gets a read grant that arrives with the intent, covers
          one file (see @xml/file_paths) and expires with it.

          Also serves the downloaded update APK to the system installer
          without it needing broad storage access — its own cache-only scope,
          nothing else shared through it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Where the Cast framework asks how this app wants to cast. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.music.violence.playback.cast.CastOptionsProvider" />

        <!--
          Tap to share, sending side: looks like an NFC Forum Type 4 NDEF tag holding the one link
          being shared. DISABLED here: NfcShareSession switches it on only while the Tap to share
          screen is showing and off again after, so the AID is not registered at any other time.
          requireDeviceUnlock keeps it from answering on a locked phone.
        -->
        <service
            android:name=".nfc.ShareHostApduService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/share_apdu_service" />
        </service>
    </application>

