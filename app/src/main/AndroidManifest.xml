<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tells Wi-Fi from mobile data, so the matching quality ceiling applies. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Saving a track to Music outlives the screen it was asked from. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Touch feedback. The system's own haptics switch is honoured on top of
         this, so granting it doesn't override a user who turned buzzing off. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bit-perfect output: setting Android 14's preferred mixer attributes
         for a USB DAC. A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      Tap to share (Phase 9). NFC is entirely optional: the app installs and works on phones
      without it, and the NFC options are simply hidden there. The camera is only for scanning a
      QR code and is asked for only when the scan screen opens (fork-docs/SHARE_DESIGN.md).
    -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Asked for only when the output picker is first opened, and only on API 31+
      where it exists. Without it a paired headset is listed by the audio
      framework under a generic name rather than its own, which turns a list of
      places to send the music into a list of things called "Bluetooth".
      Everything else in the app works without it.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
      BLUETOOTH_CONNECT's predecessor, granted at install: what reads a paired
      device's class below API 31, so the player can draw a speaker for a
      speaker. See AudioRouting.formOf.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!--
      In-app updates: handing a downloaded APK to the system installer. The
      per-app "install unknown apps" switch is still the user's to flip; this
      only lets the request reach the installer.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reading local audio files across the device -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Only for API 28 and below. From 29 the app writes to the shared Music
      folder through MediaStore, which grants access to the rows it created and
      needs no permission at all — and this one stops being grantable there.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
