# Copy to keystore.properties (repository root) and fill in. That file is gitignored: the real
# passwords must never be committed, and neither must the keystore itself.
#
# Keep the keystore OUTSIDE the repository. Create it once, in PowerShell (one line; keytool
# asks for the passwords itself, so nothing secret is typed into a script or a file):
#
#   New-Item -ItemType Directory -Force "$env:USERPROFILE\violence-keys"; keytool -genkeypair -v -keystore "$env:USERPROFILE\violence-keys\violence-release.jks" -alias violence -keyalg RSA -keysize 2048 -validity 10000
#
# BACK IT UP (the .jks file and both passwords) in at least two places that are not this
# computer or this repository. Android only installs an update if it is signed with the SAME
# key as the app already on the phone. If the key is lost, nobody can update: everyone has to
# uninstall Violence (losing their downloads and settings) and install a new one. The key can
# not be recovered or regenerated.
#
# storeFile may be an absolute path (forward slashes are easiest) or a path relative to the
# repository root. The default keystore type (PKCS12) uses one password for the store and the
# key: put the same value in both lines below.

storeFile=C:/Users/YOURNAME/violence-keys/violence-release.jks
storePassword=
keyAlias=violence
keyPassword=
