#define MyAppName "Violence"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Violence"
#define MyAppExeName "Violence.exe"

[Setup]
AppId={{D37F8A1B-89A1-4C55-9B2F-9E26388C8F7A}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL=https://github.com/kushagrasinghx/BitChord
AppSupportURL=https://github.com/kushagrasinghx/BitChord/issues
AppUpdatesURL=https://github.com/kushagrasinghx/BitChord/releases
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma2/max
SolidCompression=yes
OutputDir=dist
OutputBaseFilename=Violence-Setup
SetupIconFile=desktopApp\packaging\icons\AppIcon.ico

; Modern styling & wizard visuals
WizardStyle=modern
WizardImageFile=desktopApp\packaging\windows\wizard-large.bmp
WizardSmallImageFile=desktopApp\packaging\windows\wizard-small.bmp

; Per-user install without needing UAC / Administrator prompt
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

; Clean uninstall
UninstallFilesDir={app}\uninst

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
WelcomeLabel1=Welcome to [name]
WelcomeLabel2=This wizard will install [name/ver] on your computer.%n%nExperience seamless high-fidelity music streaming.
FinishedHeadingLabel=Setup Complete
FinishedLabel=Violence has been installed on your computer. You can launch it using the created shortcuts.

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; Distributable app directory generated by Compose Multiplatform (:desktopApp:createDistributable)
Source: "desktopApp\build\compose\binaries\main\app\Violence\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

